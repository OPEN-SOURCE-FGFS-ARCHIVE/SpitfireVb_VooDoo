<?xml version="1.0"?>
<!-- trim indicator -->
<PropertyList>
	<path>trim.ac</path>

	<animation>
		<type>rotate</type>
		<object-name>trim-Needle1</object-name>
		<property>controls/flight/elevator-trim</property>
		<interpolation>
			<entry>
				<ind>-1</ind>
				<dep>-105</dep>
			</entry>
			<entry>
				<ind>0</ind>
				<dep>0</dep>
			</entry>
			<entry>
				<ind>1</ind>
				<dep>105</dep>
			</entry>
		</interpolation>
		<center>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</center>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>

	<animation>
    <type>material</type>
    <object-name>Face</object-name>
    <object-name>trim-Needle1</object-name>
    <emission>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
      <red>0.124</red>
      <green> 0.1115 </green>
      <blue>0.075 </blue>
    </emission>
  </animation>

	<!-- *** LoD *** -->
	<animation>
		<type>range</type>
		<min-m>0</min-m>
		<max-m>5</max-m>
	</animation>
</PropertyList>
