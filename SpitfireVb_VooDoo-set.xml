        <float n="11" alias="/gear/gear[2]/rollspeed-ms"/>
        <float n="12" alias="/velocities/airspeed-kt"/>
        <float n="13" alias="/controls/flight/aileron"/>
        <float n="14" alias="/gear/gear[1]/compression-norm"/>
        <float n="15" alias="/gear/gear[2]/compression-norm"/>
        <float n="16" alias="/gear/gear[2]/caster-angle-deg"/>
        <!-- For Bombable -->
        <int type="int" n="10" alias="controls/armament/trigger">0</int>
        <string n="9" type="string" />
